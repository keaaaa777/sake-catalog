# Supabase(クリックログ用。未設定でも動作するが affiliate_clicks は記録されない)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 楽天ウェブサービス(商品検索・レシピ・ブックス・トラベルAPI共通)
# 取得先: https://webservice.rakuten.co.jp/
# APP_ID/ACCESS_KEY は scripts/fetch-rakuten-links.js 実行時のみ必要
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Google Analytics 4 測定ID(例: G-XXXXXXXXXX)。lib/gtag.ts が参照する。
NEXT_PUBLIC_GA_ID=

# 本番ドメイン。sitemap.xml / robots.txt / OGP画像の絶対URL解決に使用
NEXT_PUBLIC_SITE_URL=https://sake-catalog.vercel.app

# 掲載情報の訂正・画像削除依頼などを受け付ける公開連絡先
NEXT_PUBLIC_CONTACT_EMAIL=
